# ─── JanAwaaz environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit a real .env file.

# PostgreSQL connection (used by Prisma + the Next.js app)
DATABASE_URL="postgresql://janaawaaz:janaawaaz@localhost:5432/janaawaaz?schema=public"

# JWT signing secret for session cookies (min 16 characters, use a long random string)
JWT_SECRET="change-me-to-a-long-random-secret-min-16-chars"

# Public site URL (used for links in notifications / metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local evidence upload directory (relative to project root). Served only
# through the authenticated /api/evidence/[id] route — never publicly.
UPLOAD_DIR="./uploads"

# Max upload size in megabytes (also enforced client-side)
MAX_UPLOAD_MB="25"
